{
  "name": "cine-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/editor"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:studio": "npm run dev",
    "dev:editor": "cd apps/editor && npm run dev",
    "build:editor": "npm run build --workspace apps/editor",
    "copy:editor": "node scripts/copy-editor.mjs",
    "prebuild": "npm run build:editor && npm run copy:editor",
    "build:studio": "npm run build",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.25",
    "lucide-react": "^0.554.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.68.0",
    "tailwind-merge": "^3.4.0",
    "wavesurfer.js": "^7.12.7",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
